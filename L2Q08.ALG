Algoritmo "semnome"
// Disciplina   : [Linguagem e Lógica de Programação] 
// Professor    : Antonio Carlos Nicolodi 
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 29/10/2026
Var
nome, aumento, salario1, salario2: inteiro


Inicio
escreva("Nome do funcionario: ")
leia(nome)
escreva("Salario atual do funcionario: ")
leia(salario1)
se salario1 <= 400 entao
aumento <- 15
senao
se salario1 <= 700 entao
aumento <- 12
senao
se salario1 <= 1000 entao
aumento <- 10
senao
se salario1 <= 1800 entao
aumento <- 7
senao
se salario1 <= 2500 entao
aumento <-  4
senao
aumento <- 0
fimse
fimse
fimse
fimse
fimse


Fimalgoritmo